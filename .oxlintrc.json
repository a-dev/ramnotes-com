{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/*.d.ts",
    "dist/**",
    ".astro/**",
    ".wrangler/**",
    ".claude/**",
    ".agents/**"
  ],
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "import/first": "error"
  },
  "env": {
    "builtin": true
  }
}

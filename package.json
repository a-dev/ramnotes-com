{
  "name": "ramnotes-com",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "bun run lint && bun run lint:css && bun run format:check && bun run check:astro && bun scripts/check-contrast.ts",
    "check:astro": "astro sync && bunx --package=typescript@6.0.3 --package=@astrojs/check@0.9.12 astro-check --root .",
    "deploy": "SITE_ENV=production astro build && wrangler deploy",
    "dev": "astro dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "preview": "astro build && wrangler dev",
    "qa:env": "node scripts/check-build-env.mjs",
    "stylelint": "stylelint \"src/**/*.css\" --fix",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.2",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "lighthouse": "^13.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "stylelint": "^18.0.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2",
    "vite-css-modules": "^1.16.1",
    "wrangler": "^4.157.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}

---
import type { Tone } from "../tones";
import styles from "./note-card.module.css";
interface Props {
  tone?: Tone;
  title?: string;
  mono?: boolean;
}
const { tone = "none", title, mono = false } = Astro.props;
---

<div
  class:list={[styles.note, mono && styles.mono]}
  style={{
    "--_note-fill": `var(--color-note-${tone})`,
    "--_dot": `var(--color-tone-${tone}, var(--color-border-subtle))`,
  }}
>
  {title && <h3 class={styles.title}>{title}</h3>}
  <slot />
</div>
